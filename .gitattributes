# Git LFS tracking for model weights, cached objects and compressed arrays.
# These exceed comfortable plain-git sizes; see README "Large files".
*.pt  filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text

# Single oversized CSV: the release-building step writes a MANIFEST.sha256 over the
# working-tree file, so the bytes must round-trip unchanged. LFS guarantees that.
results/intermediate/calibration_features_ae_pre.csv filter=lfs diff=lfs merge=lfs -text

# No global line-ending normalization is applied to this package on purpose.
# The distributed `MANIFEST.sha256` lists SHA-256 digests of working-tree files; any
# automatic CRLF conversion on checkout would change those bytes and break the
# package's own integrity check. Declaring every text type as binary keeps checkout
# byte-exact across platforms.
*.sha256 -text
