# Git LFS tracking for model weights, cached objects and compressed arrays.
# These exceed comfortable plain-git sizes; see README "Large files".
*.pt  filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text

# Single oversized CSV: the release-building step writes a MANIFEST.sha256 over the
# working-tree file, so the bytes must round-trip unchanged. LFS guarantees that.
results/intermediate/calibration_features_ae_pre.csv filter=lfs diff=lfs merge=lfs -text

# Normalize text line endings; keep binary types untouched.
* text=auto
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.cff  text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
